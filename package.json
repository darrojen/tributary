{
  "name": "tributary",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "compile": "forge build",
    "test": "forge test",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh",
    "dev": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "postinstall": "npm install --workspace frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
