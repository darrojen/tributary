# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build time.

# Which Arc network this build targets: testnet | mainnet
NEXT_PUBLIC_NETWORK=testnet

# Tributary contract addresses (printed by the deploy script, or from the explorer)
NEXT_PUBLIC_FLOW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SPLIT_ADDRESS=0x0000000000000000000000000000000000000000

# Earliest block to scan for StreamCreated/SplitCreated events.
# Use the deploy transaction's block number for a fast first listing;
# 0 scans the whole chain (slower but works).
NEXT_PUBLIC_FROM_BLOCK=64323000
